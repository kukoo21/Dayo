--- !u!114 &1557907557
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1557907555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Diwata_mam
  dialogue:
    dialogueLines:
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Sino ang naglalakas-loob pumasok sa aking nasasakupan?!
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: ...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Nandito ako para makiusap.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Alisin mo na ang sumpang bumabalot sa lupaing ito.
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: "Sumpa? Hah\u2026"
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Hindi ako nagbubuga ng kadiliman nang walang dahilan.
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Isinumpa ko ang lupaing 'to dahil sa mga kasalanang ginawa nila sa akin.
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: "Sa pangungutya\u2026"
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: "Sa pananakit\u2026"
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Sa pagtataboy na parang hindi ako tao.
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: ...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: "Kung ganoon, wala akong ibang pagpipilian\u2026"
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Kung hindi ang labanan ka!
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Kung iyon ang iyong pasya, ihanda mo ang sarili mo sa sumpa ng aking
        kapangyarihan!
  unlocksQuest: 1
  questToUnlock: {fileID: 11400000, guid: 536c0bc503b2f8f438d43de61d78c678, type: 2}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: 
