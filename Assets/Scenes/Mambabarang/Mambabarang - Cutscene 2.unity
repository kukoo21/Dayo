--- !u!114 &201377914
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 201377912}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Diwata_Mambabarang Warning1
  dialogue:
    dialogueLines:
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Nawala na ang sumpa ng mambabarang, Dayo.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Kasabay nito'y natanggal na rin ang iyong maskara.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: ...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Diwata?..
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Wala na akong suot na maskara...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Pero bakit nakikita pa rin kita?
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Ang maskara ay natunaw at naging liwanag. Ang maskara at iyong pagkatao
        ay naging isa.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Tila ang mga espiritu ngayon ay natural mo nang nakikita.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Dayo, sa pagbalik mo sa iyong nayon.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Sana dalhin mo ang iyong mga naging karanasan at ikalat ang kamalayan
        tungkol sa alamat at mitolohiya ng Aklan.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Hanggang sa muling pagkikita, Dayo.
  unlocksQuest: 0
  questToUnlock: {fileID: 0}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: Final Town
