  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Diwata_Mambabarang Warning
  dialogue:
    dialogueLines:
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Phew!
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Nakalabas din tayo sa nayon.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Dayo, nararamdaman ko ang isang masamang presensya.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Mukhan malapit na tayo sa lugar ng Mambabarang.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ano ba ang mambabarang, diwata?
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Ang Mambabarang ay isang uri ng mangkukulam...
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Na gumagamit ng itim na salamangka upang manakit.
    - character:
        name: Ben
        icon: {fileID: 21300000, guid: ca91c8485ae239240ae5051a17bc3da9, type: 3}
      line: ...
    - character:
        name: Ben
        icon: {fileID: 21300000, guid: ca91c8485ae239240ae5051a17bc3da9, type: 3}
      line: Malapit ka na sa lugar ng Mambabarang, Dayo.
    - character:
        name: Ben
        icon: {fileID: 21300000, guid: ca91c8485ae239240ae5051a17bc3da9, type: 3}
      line: Bago ka makapunta doon, kailangan mo munang talunin lahat ng insekto.
  unlocksQuest: 1
  questToUnlock: {fileID: 11400000, guid: fdccd18aa0c0a774883d600c6fa7943d, type: 2}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: 
