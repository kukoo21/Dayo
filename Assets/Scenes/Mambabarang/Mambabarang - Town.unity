  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Mambabarang_Quest
  dialogue:
    dialogueLines:
    - character:
        name: John
        icon: {fileID: 21300000, guid: ca91c8485ae239240ae5051a17bc3da9, type: 3}
      line: Tulongan mo kami, Dayo...
    - character:
        name: John
        icon: {fileID: 21300000, guid: ca91c8485ae239240ae5051a17bc3da9, type: 3}
      line: May Mambabarang na nagsumpa sa aming buong nayon!
    - character:
        name: John
        icon: {fileID: 21300000, guid: ca91c8485ae239240ae5051a17bc3da9, type: 3}
      line: Nandoon siya sa dulo ng nayon, pero hindi na kami makaalis! Kinulong
        niya kami. Nag dilim ang buong paligid!
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Dayo, upang mahanap ang mambabarang...
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Kailangan muna nating makalabas sa nayon na ito.
  unlocksQuest: 1
  questToUnlock: {fileID: 11400000, guid: c0676d8ac983023459a1f84f012d6922, type: 2}
  autoPlayOnStart: 1
  triggerOnEnter: 0
  requiredActor: {fileID: 0}
  sceneToLoad: 
