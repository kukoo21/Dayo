--- !u!114 &201377914
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 201377912}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Diwata_Mambabarang Warning1
  dialogue:
    dialogueLines:
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Hindi ako halimaw...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Ginawa lang nila akong halimaw.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: (Kinuha ang maskara)...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Hindi na. Hindi na kailangan. Tingnan mo.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ang tunay na sumpa ay ang galit na kumain sa iyo...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ito ang lunas.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: (Inabot ang maskara sa Mambabarang)...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: ...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Ako...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Ako ito?...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Ang manggagamot...
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ikaw. Ang takot nila, hindi ang kasamaan mo, ang nagpalayas sa iyo.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ang maskara na ito ay salamin, at ngayon, nakikita mo na.
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: ...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Patawad...
    - character:
        name: Mambabarang
        icon: {fileID: 3836985517621604257, guid: a3324a9ca81c04e4a94349ba33244191, type: 3}
      line: Patawad sa lahat.
  unlocksQuest: 0
  questToUnlock: {fileID: 0}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: Mambabarang - Cutscene 2
