MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 363246677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: NPC_villagerGreet
  dialogue:
    dialogueLines:
    - character:
        name: Elsa
        icon: {fileID: 21300000, guid: c85db367172a72f4b804374e2b63a07e, type: 3}
      line: Tulongan mo kami, Dayo!
    - character:
        name: Elsa
        icon: {fileID: 21300000, guid: c85db367172a72f4b804374e2b63a07e, type: 3}
      line: Ang mga minamahal namin na namatay ay muling nabuhay...At naging isang
        Amaranhig.
    - character:
        name: Elsa
        icon: {fileID: 21300000, guid: c85db367172a72f4b804374e2b63a07e, type: 3}
      line: At ngayon ay ginugulo ang nayon.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ano'ng dapat kong gawin?
    - character:
        name: Elsa
        icon: {fileID: 21300000, guid: c85db367172a72f4b804374e2b63a07e, type: 3}
      line: Kailangan mo talunin ang mga Amaranhig
  unlocksQuest: 1
  questToUnlock: {fileID: 11400000, guid: 2eddcf601c6b6f6478dfef631bf91eae, type: 2}
