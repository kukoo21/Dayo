--- !u!114 &1120054377
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1120054376}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Mang_Jose
  dialogue:
    dialogueLines:
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Dayo, tulongan mo kami!
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ano po ba ang nangyayari? Bakit tila walang katao-tao sa nayong ito?
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Mga Aswang, Dayo! Pabalik-balik sila sa aming nayon! Pero ngayon... mas
        malala.
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: May naririnig kaming tunog...
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Tiktik ang tawag nila. Sabi-sabi, nasa bubong sila at naghihintay
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Tiktik?
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Oo! Kaya Dayo, ikaw lang ang pag-asa namin. Kailangan mo silang itaboy.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Paano ko po sila makikita sa ganitong dilim?
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Ang Tiktik, Dayo, ay naglalabas ng tunog na "tik-tik-tik" habang lumalapit.
        Makinig ka nang mabuti.
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Kapag mas malakas ang tunog, ibig sabihin nun malayo pa ang tiktik.
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Ngunit, pag mahina na ang tunog...
    - character:
        name: Mang Jose
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Ang ibig sabihin nun ay malapit na siya. Sundan mo lang ang ingay!
  unlocksQuest: 1
  questToUnlock: {fileID: 11400000, guid: 5c2de1a1d18ef3946ab35982ef3bfec6, type: 2}
