--- !u!114 &407288291
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 407288289}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: MangJoseWakWak1
  dialogue:
    dialogueLines:
    - character:
        name: Wakwak
        icon: {fileID: -6551468033955644977, guid: 6cd294990071ecd459ec08bb98c28699, type: 3}
      line: Wak...wak...wak!
    - character:
        name: Wakwak
        icon: {fileID: -6551468033955644977, guid: 6cd294990071ecd459ec08bb98c28699, type: 3}
      line: "Hoh\u2026 ano\u2019ng meron dito?"
    - character:
        name: Wakwak
        icon: {fileID: -6551468033955644977, guid: 6cd294990071ecd459ec08bb98c28699, type: 3}
      line: "Ang bihira naman\u2026 ang mismong biktima ang lumalapit nang kusa."
    - character:
        name: Wakwak
        icon: {fileID: -6551468033955644977, guid: 6cd294990071ecd459ec08bb98c28699, type: 3}
      line: Nakakatuwa ka, Dayo.
    - character:
        name: Wakwak
        icon: {fileID: -6551468033955644977, guid: 6cd294990071ecd459ec08bb98c28699, type: 3}
      line: "Kadalasan, kailangan ko pang habulin ang gaya mo\u2026"
    - character:
        name: Wakwak
        icon: {fileID: -6551468033955644977, guid: 6cd294990071ecd459ec08bb98c28699, type: 3}
      line: Pero ngayon, ikaw pa mismo ang nag-alok ng laman sa aking mga kuko."
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Hindi ako lumapit para maging pagkain mo.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Nandito ako para tapusin ka!
  unlocksQuest: 1
  questToUnlock: {fileID: 11400000, guid: 42eecda19f907db4aac1fc8c143d5d97, type: 2}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: 
