  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Bungisngis 1
  dialogue:
    dialogueLines:
    - character:
        name: Bungisngis
        icon: {fileID: -2134963867, guid: 6701eba5f92773d418afeefb0f21ea01, type: 3}
      line: Buwahahahaha!
    - character:
        name: Bungisngis
        icon: {fileID: -2134963867, guid: 6701eba5f92773d418afeefb0f21ea01, type: 3}
      line: Hindi ka puwedeng dumaan hangga't hindi mo sinasagot ang aking mga bugtong!
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Bugtong?.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Ang mga bugtong ay laro ng salita na may nakatagong kahulugan.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Ang susi sa pagsagot ng mga bugtong ay maingat na basahin at unawain
        ang mga tanong.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: Ok, gets ko na.
  unlocksQuest: 0
  questToUnlock: {fileID: 0}
  autoPlayOnStart: 0
  triggerOnEnter: 1
