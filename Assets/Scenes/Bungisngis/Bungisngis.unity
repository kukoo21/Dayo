  m_Script: {fileID: 11500000, guid: 996945ad5b1234e40b8903097fd87e39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  riddleText: {fileID: 1566444797}
  answerInput: {fileID: 1262231491}
  wrongCountText: {fileID: 1163228764}
  submitButton: {fileID: 1370070523}
  riddlePanel: {fileID: 922881862}
  wrongAnswerImage: {fileID: 161752924}
  correctAnswerImage: {fileID: 2119253206}
  bungisngisAnimator: {fileID: 1358059379}
  laughSFX: {fileID: 1924821123}
  deadAnimPanel: {fileID: 1308609883}
  deadAnimator: {fileID: 1375504646}
  deadAnimTrigger: Dead
  gameOverPanel: {fileID: 1756465077}
  uiDelayAfterAnimStart: 1
  riddles:
  - question: Hindi tao, hindi hayop, may katawan, walang paa, may ilong walang mukha,
      may tenga walang ulo.
    answer: martilyo
  - question: "May dila nga ngunit ayaw naman magsalita, kambal sila\u2019t laging
      kasama ang isa\u2019t-isa, itali o igapos kahit higpitan mo pa, tiyak silang
      sa iyo\u2019y sasama."
    answer: sapatos
  - question: "Ako\u2019y iyak ng iyak, patulot ang agos ng luha, kahit daanan ng
      tubig ay biyak, nilabas ko lang ang galit hanggang ito\u2019y maging bula."
    answer: ilog
  - question: Dalawang batong itim, malayo ang nararating.
    answer: mata
  - question: "Pag-aari mo, dala-dala mo, datapwa\u2019t madalas gamitin ng iba kaysa
      sa iyo."
    answer: pangalan
  - question: "Tumingin ka sa akin, ang makikita mo\u2019y ikaw din."
    answer: salamin
  - question: "May paa\u2019y walang baywang, may likod walang tiyan."
    answer: upuan
  - question: Mataas kung nakaupo, mababa kung nakatayo.
    answer: aso
  - question: "Katawan nito\u2019y hinihiwa kaya ika\u2019y lumuluha."
    answer: sibuyas
  - question: Isa ang pasukan, tatlo ang labasan.
    answer: damit
  requiredCorrectAnswers: 3
  imageDisplayTime: 1.5
  endRiddleDialogue: {fileID: 11400000, guid: 219426d0d4b945a46bb12fdbe3b6b73a, type: 2}
