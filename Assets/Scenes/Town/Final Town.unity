MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 629072805}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Lola_Greetxx
  dialogue:
    dialogueLines:
    - character:
        name: Lola
        icon: {fileID: -1140121740319091029, guid: 9dc519a6e81242849b19275580b4728b, type: 3}
      line: Apo! Andyan ka na pala.
    - character:
        name: Lola
        icon: {fileID: -1140121740319091029, guid: 9dc519a6e81242849b19275580b4728b, type: 3}
      line: Saan ka nanggaling?.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Nag-ikot lang po sa baryo.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Pasensya na po, Lola.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Nag-ikot-ikot lang po ako sa baryo. Medyo malayo lang po ang napuntahan
        ko.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Nag-ikot-ikot lang po ako sa baryo. Medyo malayo lang po ang napuntahan
        ko.
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: 81f51aab503d161488521459520b7c79, type: 3}
      line: Ang dami kong nakilalang tao... pero ang mas astig, nakakita po ako ng
        Aswang! Nakita ko ang mga nilalang na dati ko lang naririnig sa inyong mga
        kuwento! Totoo po pala sila, Lola!
  unlocksQuest: 0
  questToUnlock: {fileID: 0}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: EndCredits
