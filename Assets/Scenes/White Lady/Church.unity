--- !u!114 &2110688722
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2110688720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104a1befc3f64eb43a111c1190bd8462, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueId: Church_dialogue 2
  dialogue:
    dialogueLines:
    - character:
        name: Pedro
        icon: {fileID: 21300000, guid: d06f7848773cb424582cdf589c25f734, type: 3}
      line: "She\u2019s in pain, Lolo. Lolo. Kailangan nating kausapin siya."
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Maria?...
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Ikaw ba 'yan?
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Ako ito. Si Mateo ito.
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Mateo?..
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Hindi!
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Matanda ka na.
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Iniwan ako ng Mateo ko sa altar...
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Pinabayaan niya akong mamatay sa sakit ng puso!
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Hindi kita pinabayaan!
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Noong araw na 'yon...
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Linusob ng mga sundalo ang ating nayon. Kinaladkad ako papunta sa mga
        kampo.
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Isinigaw ko ang pangalan mo hanggang sa nawala ang boses ko.
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Hi...
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Hindi ka lumayo?
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Lumaban ako sa loob ng maraming taon para lang makabalik dito...
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Ngunit huli na ako.
    - character:
        name: White Lady
        icon: {fileID: -2228891811133599171, guid: d6967a0ebc2d5c04f9e7f0546c0902a8, type: 3}
      line: Nagbalik ka?
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Hindi kailanman umalis ang puso ko, Maria...
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Kaya pakiusap...
    - character:
        name: Lolo Mateo
        icon: {fileID: -5309972906531176128, guid: 914d4499288614a40aa95883ebba4cfa, type: 3}
      line: Magpahinga ka na.
  unlocksQuest: 0
  questToUnlock: {fileID: 0}
  autoPlayOnStart: 0
  triggerOnEnter: 1
  requiredActor: {fileID: 0}
  sceneToLoad: Church 1
