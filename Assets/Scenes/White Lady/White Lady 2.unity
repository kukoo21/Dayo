  dialogueId: Diwata_WLdialogue
  dialogue:
    dialogueLines:
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Phew!..
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Nakakaiyak naman 'yon.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: OK, pumunta na tayo sa susunod na nayon.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Pero kailangan naing mag-ingat.
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Tulad ng sinabi ng matanda...
    - character:
        name: Diwata
        icon: {fileID: 21300000, guid: 3a9ab427be28d6343a51b549dd2fb94b, type: 3}
      line: Mayroong kawan ng mga bangkay na muling nabuhay doon.
