  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e12fb904daf4cd44a96a85ebbc64e0f, type: 3}
  m_Name: Wakwak_dialogue 2
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Dayo! Ang tahimik...
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Sobrang tahimik na. Wala na ang tunog ng mga pakpak niya.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Isa kang tunay na bayani, Dayo.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: May utang na loob kami sa'yo.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Heto, tanggapin mo ito.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Ito ang maliit naming pasasalamat sa pagbabalik mo ng kapayapaan sa aming
      mga gabi.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  options:
  - optionText: Next
    nextDialogue: {fileID: 11400000, guid: e8b4c451765e53444aaef99411f8c8bd, type: 2}
