  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e12fb904daf4cd44a96a85ebbc64e0f, type: 3}
  m_Name: Mang Jose Wakwak Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Salamat sa pagtaboy mo sa mga Tiktik, Dayo.
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Doon naman tayo pumunta sa lugar ng Wakwak.
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: ...
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: Wakwak?
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Oo, Dayo.
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Ang wakwak ay uri ng Aswang na humihiwalay ang kalahati ng katawan.
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Marami sa aming mga kanayon ang naging biktima magmula nang sumalakay ang
      Wakwak.
  - speaker: {fileID: 11400000, guid: f1c6f9ba3a5c9f34194f3c27b8504472, type: 2}
    text: Dapat mong talunin ang Wakwak para tuluyan nang magwakas ang paghihirap
      namin!
  options: []
