  m_Name: Lolo_Mateo_CheckItem
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Kumusta ang paghahanap mo?
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Tingnan natin kung anong nakita mo.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: ...
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: 'Isang wedding dress... '
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: 'Isang bouquet... '
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: At love letter?
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: 'Hmm. Itong mga ''to... connected lahat. '
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Mukhang may kinalaman sila sa isang kasal.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Hmm...
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Makinig ka, Dayo...
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Magkita tayo sa lumang simbahan, para malaman natin ang buong istorya.
