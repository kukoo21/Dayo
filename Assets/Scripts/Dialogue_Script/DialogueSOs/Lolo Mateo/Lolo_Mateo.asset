%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e12fb904daf4cd44a96a85ebbc64e0f, type: 3}
  m_Name: Lolo_Mateo
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: May naghihiganting espiritu na tinatawag na White Lady d'yan sa daan papunta
      sa kabilang bayan.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Nararamdaman ko na nandoon pa rin ang lungkot niya kaya hindi siya matahimik.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: Ano'ng gagawin ko?
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Pwede ka bang pumunta doon at mag-imbestiga?
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Baka makahanap ka ng mga clues kung paano mapapalaya ang kaluluwa niya.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: Ok, susubokan ko.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Salamat, Dayo.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Bumalik ka sa akin, kapag nahanap mo na lahat ng clues.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
