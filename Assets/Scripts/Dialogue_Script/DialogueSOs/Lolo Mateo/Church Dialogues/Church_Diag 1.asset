  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e12fb904daf4cd44a96a85ebbc64e0f, type: 3}
  m_Name: Church_Diag 1
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Wala na siya...
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Sa wakas ay payapa na.
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: Ayos ka lang ba, Lolo?
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Ngayon, oo.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Dala-dala ko ang pagkakasala na 'yon habangbuhay.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Salamat, Dayo.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Hindi ko siya kayang harapin nang mag-isa...
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Bago ako umalis...
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Gusto kong tanggapin mo ito.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Magiging mahirap ang paglalakbay na hinaharap mo.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Nabalitaan ako sa kabilang nayon na ang mga bangkay doon ay muling nabuhay,
      at nanggugulo.
  - speaker: {fileID: 11400000, guid: 61e7f43cae00f11418622f8afd207916, type: 2}
    text: Salamat.
  options:
  - optionText: OK
    nextDialogue: {fileID: 11400000, guid: a2f0c94943b4c1548a63cce66b82688d, type: 2}
