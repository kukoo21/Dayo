  m_Name: Bungisngis_quest
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Handa ka na bang sagutin ang aking mga bugtong?
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: Oo!
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 7b74c278d0e28624f91a197632ab664a, type: 2}
    text: Ibigay mo na ang 'yong bugtong.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Sagutin ng tama ang tatlong bugtong at hahayaan kitang makadaan.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Sagutin ito ng mali ng dalawang beses at itataboy kita kung saan ka nanggaling.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Bwahahaha!...
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
