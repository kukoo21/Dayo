  m_Name: DialogueReward
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Magaling, magaling!
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: At dahil nasagot mo ang aking mga bugtong...
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Maaari ka ng dumaan.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Isa lamang ang payo ko sa'yo, Dayo.
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Sa susunod na nayon na iyong pupuntahan...
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: '''Wag na wag kang magpapagabi...'
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  - speaker: {fileID: 11400000, guid: 0a00414570750614b92642fc2cb7ad4d, type: 2}
    text: Bwahahahahaha...
    dialogueImage: {fileID: 0}
    imageSize: {x: 200, y: 200}
    imageOffset: {x: 0, y: 0}
  options:
  - optionText: OK
    nextDialogue: {fileID: 11400000, guid: b254672cafeb4f946aeb500af8b8a598, type: 2}
