      m_Calls: []
  m_text: "Tila may humaharang sa pasukan ng nayon\u2014ang dambuhalang nilalang
    na may iisang mata, si Bungisngis. Hinahamon ka niyang sagutin ang serye ng mga
    bugtong upang makapasok.\n\nSagutin ang Bugtong: 3/3"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4fab95903246abf4f92dbe935727f6e6, type: 2}
