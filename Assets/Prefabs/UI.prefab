  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ang White Lady ay multo ng isang taong pinatay sa lugar kung saan sila
    nagpapakita. \n\nNakasuot ng mahaba at puting bestida, madalas siyang nagmumulto
    sa mga lalawigan, nakakatakot na madidilim na kalye, pinabayaang lumang bahay,
    gusali ng paaralan, at iba pang establisyimento."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4fab95903246abf4f92dbe935727f6e6, type: 2}
  m_sharedMaterial: {fileID: -233162401267694587, guid: 4fab95903246abf4f92dbe935727f6e6, type: 2}
