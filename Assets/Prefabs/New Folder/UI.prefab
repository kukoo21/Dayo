  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ng Mambabarang ay nagpapataw ng sumpa (o curse) sa pamamagitan ng paggamit
    ng ritwal at mga insekto. \n\nGinagawa nila ang isang ritwal kung saan ipinapasok
    nila ang pangalan o gamit ng biktima. \n Ang mga insekto ay isinusumpa at inuutusan
    nilang pumasok sa katawan ng biktima. \n\nAng sumpa ay nagiging sanhi ng matinding
    sakit, pagdurugo, o pagtubo ng mga insekto sa loob ng katawan ng biktima. Karaniwan
    silang kinukuha upang maghiganti kapalit ng bayad."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4fab95903246abf4f92dbe935727f6e6, type: 2}
  m_sharedMaterial: {fileID: -233162401267694587, guid: 4fab95903246abf4f92dbe935727f6e6, type: 2}
